{
  "compilerOptions": {
    "rootDir": "..",
    "target": "ESNext",
    "module": "CommonJS",
    "outDir": "../__tests__",
    "sourceMap": true,
    "paths": {
      "<project>": ["../src"],
      "<project>/*": ["../src/*"]
    },
    "lib": ["ESNext"],
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "strictNullChecks": false,
    "noImplicitAny": false
  },
  "include": [
    "./src/**/*"
  ]
}
